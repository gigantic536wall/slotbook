# PostgreSQL connection string.
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/booking_app?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/booking_app?schema=public"

# Secret for signing admin sessions (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"

# Admin account created by `npm run db:seed`.
ADMIN_EMAIL="owner@northside.example"
ADMIN_PASSWORD="change-me"

# Secret for the daily job /api/cron/daily (Vercel sends it automatically when this variable is set).
CRON_SECRET="change-me"

# 1 = public demo: shows a demo admin login and resets all data every night.
DEMO_MODE="0"
