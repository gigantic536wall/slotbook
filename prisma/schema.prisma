// SlotBook database schema.
// A single business with services, staff, weekly working hours, time off and bookings.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// People who can sign in to the admin panel.
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  /// scrypt hash: "scrypt$<salt>$<hash>"
  passwordHash String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastLoginAt  DateTime? @db.Timestamptz(3)
}

/// Business-wide settings (one row).
model Business {
  id          Int     @id @default(1)
  name        String
  /// IANA time zone the opening hours are defined in, e.g. "Europe/Berlin".
  timeZone    String  @default("Europe/Berlin")
  /// Step between possible start times, in minutes.
  slotStepMin Int     @default(15)
  /// How many days ahead customers can book.
  bookingDays Int     @default(30)
  email       String?
  phone       String?
  address     String?
}

model Service {
  id          Int            @id @default(autoincrement())
  nameEn      String
  nameDe      String
  descEn      String?
  descDe      String?
  durationMin Int
  priceCents  Int
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  staff       StaffService[]
  bookings    Booking[]
}

model Staff {
  id           Int            @id @default(autoincrement())
  name         String
  titleEn      String?
  titleDe      String?
  active       Boolean        @default(true)
  services     StaffService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  bookings     Booking[]
}

model StaffService {
  staffId   Int
  serviceId Int
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

/// Weekly schedule: one row per working interval. weekday: 0 = Sunday ... 6 = Saturday.
/// startMin / endMin are minutes from midnight in the business time zone.
model WorkingHours {
  id       Int   @id @default(autoincrement())
  staffId  Int
  weekday  Int
  startMin Int
  endMin   Int
  staff    Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

/// Vacations, sick days, breaks.
model TimeOff {
  id       Int      @id @default(autoincrement())
  staffId  Int
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Overlapping CONFIRMED bookings for the same staff member are rejected by a
/// PostgreSQL exclusion constraint (see the migration "booking_no_overlap").
model Booking {
  id            Int           @id @default(autoincrement())
  staffId       Int
  serviceId     Int
  startsAt      DateTime      @db.Timestamptz(3)
  endsAt        DateTime      @db.Timestamptz(3)
  status        BookingStatus @default(CONFIRMED)
  /// Price at the moment of booking, so later price changes don't rewrite history.
  priceCents    Int
  customerName  String
  customerEmail String
  customerPhone String?
  note          String?
  locale        String        @default("en")
  /// Secret token for the customer's manage/cancel link.
  manageToken   String        @unique
  /// When the customer agreed to the privacy policy (GDPR).
  consentAt     DateTime      @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  cancelledAt   DateTime?     @db.Timestamptz(3)
  staff         Staff         @relation(fields: [staffId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])

  @@index([staffId, startsAt])
  @@index([customerEmail])
}
